<script>
  (function () {
    var price = document.getElementById('price');
    var sum = document.getElementById('sum');
    var save = document.getElementById('save');
    var out = document.getElementById('result');
    var sub = document.getElementById('resultSub');
    var fmt = new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 0 });

    function plural(n) {
      var m = n % 100, d = n % 10;
      if (m >= 11 && m <= 14) return 'обменов';
      if (d === 1) return 'обмен';
      if (d >= 2 && d <= 4) return 'обмена';
      return 'обменов';
    }

    function update() {
      var p = parseFloat(price.value) || 0;
      var s = parseFloat(sum.value) || 0;
      var v = parseFloat(save.value) || 0;
      if (v <= 0) {
        out.textContent = '—';
        sub.textContent = 'Укажите экономию больше нуля';
        return;
      }
      var n = Math.max(Math.ceil(p / v), 0);
      out.textContent = fmt.format(n) + ' ' + plural(n);
      sub.textContent = 'Это около ' + fmt.format(n * s) + ' ₽ обменянных денег';
    }
    [price, sum, save].forEach(function (el) { el.addEventListener('input', update); });
    update();
  })();
</script>
