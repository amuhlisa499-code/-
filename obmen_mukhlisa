<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Обмен юаней с нуля: обучение Мухлисы</title>
<meta name="description" content="Научись самостоятельно менять юани с моим сопровождением: от первого обмена до работы с клиентами.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600&family=Unbounded:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #EDF0F3;
    --panel: #F8F9FB;
    --fg: #071739;
    --muted: #4B6382;
    --line: #CDD5DB;
    --accent: #7E5F3F;
    --btn-bg: #071739;
    --btn-fg: #E3C39D;
    --focus: #4B6382;
    --band: #071739;
    --band-fg: #EDF0F3;
    --band-muted: #A4B5C4;
    --sand: #E3C39D;
    --tan: #A68868;
    --font-display: "Unbounded", "Onest", system-ui, sans-serif;
    --font-body: "Onest", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    color-scheme: light;
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  html { scroll-padding-top: env(safe-area-inset-top, 0px); scroll-behavior: smooth; background: var(--bg); }
  *, *::before, *::after { box-sizing: inherit; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3 { font-family: var(--font-display); font-weight: 600; line-height: 1.18; margin: 0; overflow-wrap: break-word; hyphens: auto; }
  h1 { font-size: clamp(1.65rem, 6vw, 2.9rem); letter-spacing: -0.01em; }
  h2 { font-size: clamp(1.35rem, 4.6vw, 2.05rem); letter-spacing: -0.005em; }
  h3 { font-size: 1.05rem; font-weight: 500; }
  p { margin: 0; }
  a { color: inherit; }

  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
  .section { padding: 64px 0; }
  .section.flush { padding-top: 0; }
  .section-head { max-width: 640px; margin-bottom: 36px; }
  .section-head p { margin-top: 12px; color: var(--muted); }

  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 50px; padding: 13px 24px;
    background: var(--btn-bg); color: var(--btn-fg);
    font-weight: 600; font-size: 1rem; text-decoration: none;
    border-radius: 10px; border: 2px solid var(--btn-bg);
    transition: transform .15s ease, filter .15s ease;
  }
  .btn:hover { filter: brightness(1.12); transform: translateY(-1px); }
  .btn.on-band { background: var(--sand); color: #071739; border-color: var(--sand); }
  a:focus-visible, button:focus-visible, input:focus-visible, summary:focus-visible {
    outline: 3px solid var(--focus); outline-offset: 3px;
  }
  .band a:focus-visible, .plan.pro a:focus-visible { outline-color: var(--sand); }
  .textlink { font-weight: 500; text-underline-offset: 4px; }

  .topbar { display: flex; align-items: center; justify-content: space-between; padding-top: 18px; padding-bottom: 18px; gap: 12px; }
  .brand { font-family: var(--font-display); font-weight: 600; font-size: .95rem; text-decoration: none; }
  .topbar .btn { min-height: 42px; padding: 8px 16px; font-size: .92rem; }

  /* Hero */
  .hero { padding: 24px 0 64px; }
  .hero-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 48px; align-items: center; }
  .avatar { margin: 0; }
  .avatar img { display: block; width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 28px 6px 28px 6px; border: 1px solid var(--line); background: var(--panel); }
  .lead { margin-top: 20px; font-size: 1.15rem; color: var(--muted); max-width: 30em; }
  .actions { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 14px 22px; align-items: center; }

  /* Story */
  .story { max-width: 720px; }
  .story h2 { margin-bottom: 24px; }
  .story p { margin-top: 16px; font-size: 1.1rem; }
  .story p.first { font-size: 1.3rem; line-height: 1.5; margin-top: 0; }
  .story p.soft { color: var(--muted); }

  /* Payback */
  .payback { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .payback p { margin-top: 14px; color: var(--muted); font-size: 1.1rem; }
  .calc { background: var(--panel); border: 1px solid var(--line); border-top: 6px solid var(--tan); border-radius: 20px; padding: 24px; }
  .calc label { display: block; margin-top: 14px; font-size: .9rem; color: var(--muted); }
  .calc label:first-child { margin-top: 0; }
  .calc input {
    display: block; width: 100%; margin-top: 6px;
    font: inherit; font-size: 1.05rem; color: var(--fg);
    background: var(--bg); border: 1px solid var(--line); border-radius: 8px;
    padding: 10px 12px; min-height: 46px;
  }
  .result-label { margin-top: 22px; font-size: .9rem; color: var(--muted); }
  .result { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.6rem, 6vw, 2.3rem); color: var(--accent); line-height: 1.15; }
  .result-sub { margin-top: 4px; color: var(--muted); }
  .note { margin-top: 12px; font-size: .85rem; color: var(--muted); }

  /* Band */
  .band { background: var(--band); color: var(--band-fg); }
  .pains { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 28px 48px; }
  .pains li { border-top: 2px solid var(--sand); padding-top: 14px; font-size: 1.15rem; font-weight: 500; }
  .pains-end { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; }
  .pains-end strong { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.2rem, 4vw, 1.6rem); }

  /* Values */
  .values { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 32px 48px; }
  .values li { border-top: 2px solid var(--tan); padding-top: 16px; }
  .values strong { display: block; font-size: 1.15rem; font-weight: 600; margin-bottom: 6px; }
  .values span { color: var(--muted); }

  /* Audience */
  .audience { display: grid; grid-template-columns: 1fr 1fr; gap: 0 48px; }
  .audience div { padding: 16px 0; border-bottom: 1px solid var(--line); font-weight: 500; }
  .audience-note { margin-top: 28px; max-width: 640px; color: var(--muted); }

  /* Program */
  .modules { list-style: none; margin: 0; padding: 0; counter-reset: m; max-width: 780px; }
  .modules li { counter-increment: m; display: grid; grid-template-columns: 56px 1fr; gap: 8px 16px; padding: 22px 0; border-top: 1px solid var(--line); }
  .modules li:last-child { border-bottom: 1px solid var(--line); }
  .modules li::before { content: counter(m); font-family: var(--font-display); font-weight: 600; font-size: 1.6rem; color: var(--accent); line-height: 1.1; }
  .modules p { color: var(--muted); margin-top: 4px; }
  .modules .tag { display: block; margin-top: 6px; font-size: .85rem; font-weight: 600; color: var(--accent); }

  /* Reviews */
  .reviews { columns: 2; column-gap: 20px; }
  .review { break-inside: avoid; margin: 0 0 20px; border: 1px solid var(--line); border-radius: 6px 22px 6px 22px; overflow: hidden; background: var(--panel); }
  .review:nth-child(even) { border-radius: 22px 6px 22px 6px; }
  .review img { display: block; width: 100%; height: auto; }
  .reviews-note { margin-top: 4px; font-size: .9rem; color: var(--muted); max-width: 640px; }

  /* Plans */
  .plans { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; align-items: stretch; max-width: 860px; }
  .plan { background: var(--panel); border: 1px solid var(--line); border-radius: 16px; padding: 28px 24px; display: flex; flex-direction: column; }
  .plan.pro { background: var(--band); color: var(--band-fg); border-color: var(--band); border-radius: 26px 6px 26px 6px; }
  .plan .price { font-family: var(--font-display); font-weight: 600; font-size: 2.1rem; margin: 12px 0 4px; }
  .plan .seats { font-weight: 600; font-size: .92rem; color: var(--accent); }
  .plan.pro .seats { color: var(--sand); }
  .plan ul { margin: 18px 0 26px; padding-left: 1.1em; display: grid; gap: 10px; color: var(--muted); flex: 1; }
  .plan.pro ul { color: var(--band-muted); }
  .plan .btn { width: 100%; }
  .plan.pro .btn { background: var(--sand); color: #071739; border-color: var(--sand); }
  .plans-note { margin-top: 20px; max-width: 640px; color: var(--muted); font-size: .95rem; }

  /* FAQ */
  .faq { max-width: 780px; }
  details { border-top: 1px solid var(--line); padding: 4px 0; }
  details:last-child { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; padding: 16px 0; font-weight: 500; font-size: 1.05rem; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; font-size: 1.4rem; line-height: 1; color: var(--accent); transition: transform .2s ease; }
  details[open] summary::after { transform: rotate(45deg); }
  details p { padding: 0 0 18px; color: var(--muted); max-width: 40em; }

  /* Final */
  .final h2 { max-width: 22em; font-size: clamp(1.3rem, 4.2vw, 1.9rem); }
  .final p { margin-top: 16px; color: var(--band-muted); max-width: 32em; }
  .final .btn { margin-top: 26px; }
  .final .small { margin-top: 14px; font-size: .95rem; }

  footer { padding: 28px 0 40px; font-size: .85rem; color: var(--muted); }
  footer p + p { margin-top: 8px; }

  @media (max-width: 800px) {
    .section { padding: 48px 0; }
    .hero { padding: 12px 0 48px; }
    .hero-grid, .payback, .pains, .values, .audience, .plans { grid-template-columns: 1fr; }
    .hero-grid { gap: 28px; }
    .payback { gap: 28px; }
    .pains, .values { gap: 22px; }
    .reviews { columns: 1; }
    .modules li { grid-template-columns: 40px 1fr; }
    .actions .btn, .pains-end .btn, .final .btn { width: 100%; }
    .story p.first { font-size: 1.2rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .btn, summary::after { transition: none; }
    .btn:hover { transform: none; }
  }
</style>
</head>
